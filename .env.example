# ============================================================
# ETHIOPIA//360 — environment configuration
# Copy this file to `.env.local` and fill in the values.
#
# The application runs WITHOUT any of these values in "demo mode":
# seed content is served from `src/data`, and write actions
# (upload / like / comment / follow) report that they are not
# persisted. Nothing is faked — the UI tells you what is missing.
# ============================================================

# --- Supabase (required for auth, database, storage, persistence) ---
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# "anon" / public key. Safe to expose in the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose as NEXT_PUBLIC_*. Used by admin/seed scripts only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Public storage bucket name (created by supabase/schema.sql) ---
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=media

# --- Site metadata ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Demo mode secret (HMAC key for the local demo session cookie) ---
# Only used when Supabase is NOT configured. Generate with:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
DEMO_SESSION_SECRET=
